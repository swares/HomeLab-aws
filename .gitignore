# OpenTofu
.terraform/
# .terraform.lock.hcl is deliberately NOT ignored. It pins the exact provider
# builds so the workstation and the n150-2 teardown timer cannot resolve to
# different providers. It was ignored here until 2026-09-21; that was a mistake.
*.tfstate
*.tfstate.*
crash.log
terraform.tfvars
*.auto.tfvars
override.tf
override.tf.json

# Never commit
*.pem
*.key
kubeconfig*
.aws/
teardown.env

# Python bytecode (stub.py, scripts/backlog-audit.py)
__pycache__/
